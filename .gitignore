/config.yaml
# Ignore ad-hoc images, but app icons are site content and must ship.
# (A parent dir can't be un-ignored, hence the /* + negation.)
/static/images/*
!/static/images/apps/
.vscode

### Hugo ###
# Generated files by hugo
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Executable may be added to repository
hugo.exe
hugo.darwin
hugo.linux

# Temporary lock file while building
.hugo_build.lock
